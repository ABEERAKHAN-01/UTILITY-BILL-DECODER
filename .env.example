# Model configuration (non-secret values are real; replace only the API key)
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=Api key
# Runtime tuning. Free Gemini tier = 15 requests/min -> keep the 4.5 s delay.
REQUEST_DELAY_SECONDS=4.5
MAX_WORKERS=2
CACHE_DIR=.cache
MAX_IMAGE_SIDE=2400
